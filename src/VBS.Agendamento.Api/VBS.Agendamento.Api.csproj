<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Se o seu computador tiver só o .NET 9 ou 10, troque net8.0 pela sua versão. O RollForward deixa o programa rodar em runtime mais novo. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VBS.Agendamento.Api</RootNamespace>
    <AssemblyName>VBS.Agendamento.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contrato OpenAPI servido em /openapi.yaml (só em Desenvolvimento). -->
    <None Update="contrato\openapi.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
